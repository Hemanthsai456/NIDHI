# =============================================================================
# NIDHI - AI Investor Super App  |  .gitignore
# =============================================================================

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# SQLite fallback database
*.db
*.sqlite
*.sqlite3
nidhi_local.db

# mypy / pyright / ruff / pytest caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ─── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
.yarn/install-state.gz

# Build output
frontend/dist/
frontend/build/

# Vite cache
.vite/
frontend/.vite/

# TypeScript compilation output
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─── OS / Editor Artifacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains IDEs
.idea/
*.iml

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Misc ────────────────────────────────────────────────────────────────────
*.bak
*.swp
*.swo
*~
.cache/
tmp/
temp/
