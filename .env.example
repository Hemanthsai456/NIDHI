# =============================================================================
# NIDHI - AI Investor Super App  |  Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.
#
#   cp .env.example .env
#
# =============================================================================


# ─── Firebase (Frontend) ─────────────────────────────────────────────────────
# Obtain these from your Firebase project console:
#   https://console.firebase.google.com → Project Settings → General → Your apps
#
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API base URL (used by the frontend to call FastAPI)
# For local development: http://localhost:8000
# For production: https://your-deployed-backend.com
VITE_API_URL=http://localhost:8000



# ─── PostgreSQL Database (Backend) ───────────────────────────────────────────
# Supported providers: Neon, Supabase, Railway, local PostgreSQL.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
#
# Neon example:
#   DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx.neon.tech/neondb?sslmode=require
#
# Local PostgreSQL example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nidhi
#
# Leave empty to fall back to a local SQLite file (nidhi_local.db):
#   DATABASE_URL=
#
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Allowed frontend origin for CORS (backend reads this)
# For local dev this is set automatically — only needed for production deployments
FRONTEND_URL=https://your-deployed-frontend.com



# ─── AI / LLM API Keys ───────────────────────────────────────────────────────
# Required for the AI Financial Assistant chat to use Google Gemini 2.0 Flash.
# Get a free key at: https://aistudio.google.com/app/apikey
# Without this key, the assistant falls back to the local rule-based engine.
#
GEMINI_API_KEY=your_google_gemini_api_key_here
#
# (Optional) OpenAI — not currently used by NIDHI, reserved for future use.
# OPENAI_API_KEY=your_openai_api_key_here
