# =============================================================================
# NIDHI - AI Investor Super App  |  .gitattributes
# Normalize line endings to LF in the repository for cross-platform consistency.
# =============================================================================

# Default: normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly LF for source files
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.txt       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.csv       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf

# Binary files — do not modify
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.webp      binary
